# Configuración del Servidor
PORT=3000 # Puerto en el que correrá la aplicación

# HTTPS directo en Nest (sin Apache delante). Definir las dos juntas; vacías = HTTP.
# Usar fullchain.pem, no cert.pem. Reiniciar el backend al renovar el certificado.
HTTPS_KEY_PATH=     # ej: /etc/letsencrypt/live/mpp-smau.fcpn.edu.bo/privkey.pem
HTTPS_CERT_PATH=    # ej: /etc/letsencrypt/live/mpp-smau.fcpn.edu.bo/fullchain.pem

# Orígenes permitidos (separados por coma). En producción es obligatorio y no puede ser *
CORS_ORIGIN=http://localhost:5173

# NODE_ENV=production activa el sync inicial con MOF y la validación estricta de CORS
NODE_ENV=development

# Configuración de la Base de Datos (PostgreSQL)
DB_HOST=localhost       # Host de la base de datos
DB_PORT=5432            # Puerto de PostgreSQL
DB_USERNAME=postgres    # Usuario de la base de datos
DB_PASSWORD=postgres    # Contraseña del usuario
DB_DATABASE=mpp_db      # Nombre de la base de datos

# Configuración de JWT (JSON Web Token)
JWT_SECRET=super_secret_key_random_string # Clave secreta para firmar los tokens
JWT_EXPIRES_IN=1d                          # Tiempo de expiración del token (ej: 1h, 1d, 7d)

# Integración con el backend de MOF (unidades y cargos)
# MOF_API_URL: URL base del backend de MOF, sin barra final
# MOF_SERVICE_TOKEN: mismo valor que MPP_SERVICE_TOKEN en el .env de MOF (se envía en el header X-Api-Key)
# MOF_TLS_REJECT_UNAUTHORIZED: false si el MOF sirve HTTPS con cadena incompleta
#   (error UNABLE_TO_VERIFY_LEAF_SIGNATURE). Idealmente el MOF debe servir fullchain.pem.
MOF_API_URL=https://mof-smau.fcpn.edu.bo:3000
MOF_SERVICE_TOKEN=
MOF_TLS_REJECT_UNAUTHORIZED=false
