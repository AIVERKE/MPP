# ==============================================================================
# .gitignore - Proyecto MPP
# ==============================================================================

# Dependencias (backend y frontend)
node_modules/
.pnp
.pnp.js

# Salidas de compilación / Build
dist/
dist-ssr/
*.tsbuildinfo
build/

# Variables de entorno y secretos
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.docker.example

# Logs y depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura y reportes de pruebas
coverage/
.nyc_output/

# Editores y entornos de desarrollo (IDE)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-*

# Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales
scratch/
tmp/
temp/

# Reglas y skills locales de IA (TIC-FCPN) - Solo local, no subir
.agents/
.claude/
.ai-tic-fcpn.json
*AGENTS.md
*GEMINI.md
