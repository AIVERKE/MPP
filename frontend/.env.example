# Variables de entorno del frontend (Vite)
#
# Desarrollo: copiar este archivo como .env
# Producción: crear .env.production en el servidor ANTES de ejecutar `npm run build`
#
# Vite incrusta estos valores en el bundle al compilar: si se cambia alguna
# variable, hay que volver a ejecutar `npm run build`.
# Todas las variables VITE_* quedan visibles en el navegador: no colocar secretos.

# URL base del backend NestJS (sin barra final).
# Desarrollo:  http://localhost:3000
# Producción:  https://mpp-smau.fcpn.edu.bo:3000
VITE_API_URL=http://localhost:3000

# Modo de autenticación: local | umsa | auto (por defecto: auto)
#   local -> solo login contra el backend (VITE_API_URL/auth/login)
#   umsa  -> solo login contra UMSA Core (VITE_UMSA_TOKEN_URL)
#   auto  -> intenta primero el backend; si no responde (error de red), usa UMSA Core
VITE_AUTH_MODE=auto

# URL base del servicio UMSA Core (sin barra final)
VITE_UMSA_CORE_URL=https://correspondencia.fcpn.edu.bo/umsa-core

# Opcional: endpoint OAuth de UMSA Core.
# Si se omite, se usa ${VITE_UMSA_CORE_URL}/oauth/token
# VITE_UMSA_TOKEN_URL=https://correspondencia.fcpn.edu.bo/umsa-core/oauth/token
